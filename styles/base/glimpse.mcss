GlimpsePanel {
  div.glimpse-quiet {
    padding: 20px
    text-align: center
    font-style: italic
  }
}

Glimpse {
  margin: 10px
  padding: 15px
  border-radius: 4px

  -pinned {
    padding: 8px 15px
    div.glimpse-head {
      align-items: center
    }
  }

  div.glimpse-head {
    display: flex
    align-items: flex-start
    div.glimpse-avatar {
      margin-right: 12px
      img {
        width: 64px
        height: 64px
        border-radius: 3px
        object-fit: cover
      }
      div.glimpse-blank {
        width: 64px
        height: 64px
        border-radius: 3px
      }
    }
    div.glimpse-identity {
      flex: 1
      min-width: 0
      div.glimpse-name {
        font-size: 130%
        font-weight: bold
        word-break: break-all
      }
      div.glimpse-where {
        font-size: 90%
        margin-top: 2px
      }
    }
    div.glimpse-action {
      text-align: right
      button {
        white-space: nowrap
      }
      div.glimpse-status {
        font-size: 85%
        margin-top: 4px
        max-width: 220px
      }
    }
  }

  div.glimpse-description {
    margin-top: 10px
  }

  blockquote.glimpse-statement {
    margin: 12px 0 0 0
    padding: 8px 12px
    font-size: 110%
    font-style: italic
  }

  div.glimpse-provenance {
    margin-top: 14px
    padding-top: 8px
    div.glimpse-provenance-line {
      font-size: 85%
    }
    div.glimpse-caveat {
      font-size: 80%
      margin-top: 3px
      font-style: italic
    }
  }

  div.glimpse-waiting {
    margin-top: 10px
    font-size: 90%
    font-style: italic
  }
}
