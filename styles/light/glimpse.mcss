GlimpsePanel {
  div.glimpse-quiet {
    color: #8a8a8a
  }
}

Glimpse {
  background: white
  border: 1px solid #d8d8d8

  div.glimpse-head {
    div.glimpse-avatar {
      div.glimpse-blank {
        background: #e4e4e4
      }
    }
    div.glimpse-identity {
      div.glimpse-name {
        color: #222
      }
      div.glimpse-where {
        color: #8a8a8a
      }
    }
    div.glimpse-action {
      div.glimpse-status {
        color: #6a6a6a
      }
    }
  }

  blockquote.glimpse-statement {
    border-left: 3px solid #c9c9c9
    color: #333
  }

  div.glimpse-provenance {
    border-top: 1px solid #ededed
    div.glimpse-provenance-line {
      color: #7a7a7a
    }
    div.glimpse-caveat {
      color: #9a9a9a
    }
  }

  div.glimpse-waiting {
    color: #8a8a8a
  }
}
